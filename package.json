{
  "name": "starbucks-inventory-system",
  "version": "1.0.0",
  "description": "Starbucks Inventory Management System (MERN Stack)",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "starbucks",
    "inventory",
    "mern",
    "mongodb",
    "express",
    "react",
    "vite",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
