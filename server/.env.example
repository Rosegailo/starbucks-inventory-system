# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/starbucks_inventory
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/starbucks_inventory?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/starbucks_inventory

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Signing Secret (Change this to a long random string in production)
JWT_SECRET=starbucks_partner_portal_super_secret_key

# Static Single-Branch Partner Credentials (used by seed & first-run init)
BRANCH_USER_ID=SBX-1001
BRANCH_USER_PASSWORD=Starbucks123!
BRANCH_PARTNER_NAME=Branch Manager
BRANCH_LOCATION=Starbucks Branch #1024

# Environment
NODE_ENV=development
