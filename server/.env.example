# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/starbucks_inventory
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/starbucks_inventory?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/starbucks_inventory

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
